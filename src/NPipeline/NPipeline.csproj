<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- NuGet Packaging Metadata -->
        <PackageId>NPipeline</PackageId>
        <Description>High-performance, streaming data pipelines for .NET</Description>
        <Authors>NPipeline contributors</Authors>
        <PackageTags>data;pipeline;stream;etl;lineage</PackageTags>
        <RepositoryUrl>https://github.com/NPipeline/NPipeline.git</RepositoryUrl>
        <PackageProjectUrl>https://github.com/NPipeline/NPipeline</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <Deterministic>true</Deterministic>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <PropertyGroup>
        <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\icon.png" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    </ItemGroup>

    <ItemGroup>
        <!--
            The analyzers and their fixes ship inside this package rather than as a package of their own,
            so every consumer gets them without opting in. ReferenceOutputAssembly is off because the
            library does not use them; the ProjectReferences are here for build order, and the DLLs travel
            in analyzers/dotnet/cs, which is where the compiler looks. Analyzers flow to consumers of any
            package that depends on this one.
        -->
        <ProjectReference Include="../NPipeline.Analyzers/NPipeline.Analyzers.csproj" PrivateAssets="All" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="../NPipeline.CodeFixes/NPipeline.CodeFixes.csproj" PrivateAssets="All" ReferenceOutputAssembly="false"/>

        <None Include="../NPipeline.Analyzers/bin/$(Configuration)/netstandard2.0/NPipeline.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
        <None Include="../NPipeline.CodeFixes/bin/$(Configuration)/netstandard2.0/NPipeline.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>

        <!--
            The optimization-profile property the analyzers read. buildTransitive/ carries it to projects
            that only reference a connector; build/ covers clients that predate buildTransitive.
        -->
        <None Include="build/NPipeline.props" Pack="true" PackagePath="build/NPipeline.props"/>
        <None Include="build/NPipeline.props" Pack="true" PackagePath="buildTransitive/NPipeline.props"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="NPipeline.Tests"/>
        <InternalsVisibleTo Include="NPipeline.Extensions.Nodes.Tests"/>
        <InternalsVisibleTo Include="NPipeline.Extensions.Parallelism.Tests"/>
        <InternalsVisibleTo Include="NPipeline.Extensions.Parallelism"/>
        <InternalsVisibleTo Include="NPipeline.Extensions.Composition"/>
        <InternalsVisibleTo Include="NPipeline.Extensions.DependencyInjection"/>
        <InternalsVisibleTo Include="NPipeline.Extensions.Lineage"/>
        <InternalsVisibleTo Include="NPipeline.Extensions.Lineage.Tests"/>
        <InternalsVisibleTo Include="NPipeline.Extensions.Observability"/>
        <InternalsVisibleTo Include="NPipeline.Extensions.Observability.Tests"/>
        <InternalsVisibleTo Include="NPipeline.Extensions.Testing"/>
        <InternalsVisibleTo Include="NPipeline.Benchmarks"/>
    </ItemGroup>

</Project>
